diff --git a/components/script/dom/html/embedded_content/htmlmediaelement.rs b/components/script/dom/html/embedded_content/htmlmediaelement.rs
index b6485e65c..b8cc24e6e 100644
--- a/components/script/dom/html/embedded_content/htmlmediaelement.rs
+++ b/components/script/dom/html/embedded_content/htmlmediaelement.rs
@@ -3026,9 +3026,13 @@ impl HTMLMediaElement {
             ) {
                 self.queue_media_element_task_to_fire_event(atom!("resize"));
             } else {
-                // If the natural dimensions have not been changed, the node should be marked as
-                // damaged to force a repaint with the new frame contents.
-                self.upcast::<Node>().dirty(no_gc, NodeDamage::Other);
+                // The natural dimensions have not changed, so the new frame went to the
+                // renderer as an in-place update of the same image key (see
+                // `MediaFrameRenderer::render`) and the display list is still valid. Only a
+                // new frame is needed, not a restyle and relayout of the whole page, which on a
+                // heavy page (YouTube) costs ~100 ms per video frame and freezes the page.
+                // This is the request animated images use for the same reason.
+                self.owner_document().set_has_pending_animated_image_update();
             }
         }
     }
